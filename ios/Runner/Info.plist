<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Birthday App</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>birthday_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- The app talks to a local Supabase stack (http://127.0.0.1:54321) during
	     development, and ATS blocks cleartext HTTP by default. This exception
	     permits cleartext ONLY to local-network destinations; it does not
	     disable ATS globally (that would be NSAllowsArbitraryLoads, which this
	     deliberately avoids) and a hosted deployment reached over HTTPS never
	     exercises it. Safe to leave in for production; it only ever relaxes
	     local-network traffic. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Without this key, iOS terminates the process with SIGABRT the moment
	     ImportCubit.start() calls FlutterContacts.requestPermission(), which
	     reaches CNContactStore().requestAccess; the literal twin of the
	     ATS defect fixed above, in this same file. Copy matches the app's
	     own disclosure text (AppStrings.importDisclosureBody): the app reads
	     contacts so the user can pick who to celebrate, and never stores
	     them on a server. -->
	<key>NSContactsUsageDescription</key>
	<string>Birthday reads the names and numbers in your contacts so you can pick who you want to celebrate. Your contacts are never stored on our servers and are never shared with anyone.</string>
</dict>
</plist>
