<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ (API 28+) blocks cleartext HTTP by default -- the same problem
  the 56446e0 fix addressed on iOS with NSAllowsLocalNetworking, but that fix
  was iOS-only, so http://<local Supabase host>:54321 is still blocked here.

  This permits cleartext ONLY to local-network addresses (loopback, the
  Android emulator's host alias, and "localhost") -- it does NOT set
  android:usesCleartextTraffic="true" on the <application> tag, which would
  allow cleartext to ANY host the app talks to, forever, the same
  "arbitrary loads" blast radius NSAllowsArbitraryLoads was rejected for on
  iOS. A hosted deployment reached over HTTPS never exercises this config at
  all -- domain-config only relaxes cleartext for the three hosts listed.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- The Android emulator's alias for the host machine's loopback --
             see the comment on ApiClient.url for the --dart-define an
             emulator run needs. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
