{
  "version": "0.2.0",
  "configurations": [
    {
      // Local Supabase stack (`supabase start`). The key is the CLI's fixed
      // local demo anon key, not a secret. The pre-launch task forwards the
      // device's 127.0.0.1:54321 to this Mac over USB, so the default
      // SUPABASE_URL works on both a USB phone and an emulator.
      "name": "birthday_app (local Supabase)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "preLaunchTask": "adb reverse supabase",
      "toolArgs": [
        "--dart-define=SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
      ]
    }
  ]
}
